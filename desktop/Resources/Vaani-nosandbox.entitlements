<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DIAGNOSTIC BUILD ONLY (SANDBOX=0). Used to tell apart "Core Audio
	     taps do not work in the sandbox" from other faults on a test Mac.
	     Never hand this build out. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
