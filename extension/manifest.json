{
  "manifest_version": 3,
  "name": "Vaani: Meeting Notes for Meet, Teams and Zoom",
  "short_name": "Vaani",
  "version": "1.0.0",
  "description": "Free meeting notes in 22 languages. When a Meet, Teams or Zoom call starts in Chrome, Vaani offers to take notes. No sign-up.",
  "homepage_url": "https://pradeep411.github.io/vaani/",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Vaani meeting notes",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://app.zoom.us/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
