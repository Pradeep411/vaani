{
  "manifest_version": 3,
  "name": "Vaani: AI Meeting Notes for Google Meet, Teams and Zoom",
  "short_name": "Vaani",
  "version": "1.0.0",
  "description": "Free AI meeting notes, transcripts and action items for Google Meet, Teams and Zoom. 22 languages incl. Hindi. No sign-up, no bot.",
  "homepage_url": "https://pradeep411.github.io/vaani/",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Vaani meeting notes",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://app.zoom.us/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
